# انسخ هذا الملف باسم .env وحط فيه القيم الحقيقية (لا ترفع .env لـ git أبداً)
BOT_TOKEN=

# مفتاح ZenRows (zenrows.com) — يستخدم فقط لفحص مزاد قطر (المحمي بـ Cloudflare)
ZENROWS_API_KEY=

# اختياري لكن يُنصح فيه بشدة: GitHub Personal Access Token (fine-grained) بصلاحية
# Contents: Read & Write على هذا المستودع فقط — يحمي بيانات المستخدمين والتنبيهات
# من الضياع لو انصفر قرص Render (نشر جديد، إعادة تشغيل...). بدونه، كل شيء يشتغل
# عادي بس بدون حماية من فقدان البيانات.
GITHUB_TOKEN=
# اختياري: يتغيّر فقط لو نقلت الكود لمستودع ثاني
# GITHUB_REPO=marri555/qatar-deals-radar

# اختياري: منفذ الخادم المحلي (Render يحدده تلقائياً عبر PORT)
# PORT=10000
